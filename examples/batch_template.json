    {"type": "text", "text": "{{name}}", "font": "NotoSansSC-Medium", "size": 46,
     "color": "C8892F", "x": 60, "y": 320, "name": "Name"},
    {"type": "text", "text": "{{dept}}  ·  NO.{{id}}", "font": "NotoSansSC-Light", "size": 26,
