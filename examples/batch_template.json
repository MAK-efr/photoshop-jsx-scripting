  "doc": {"w": 900, "h": 600, "dpi": 72, "bg": "14161A", "name": "CERT"},
  "layers": [
    {"type": "rect", "x1": 0, "y1": 0, "x2": 900, "y2": 600, "color": "14161A", "name": "BG"},
    {"type": "rect", "x1": 60, "y1": 60, "x2": 840, "y2": 64, "color": "C8892F", "name": "RuleTop"},
    {"type": "rect", "x1": 60, "y1": 536, "x2": 840, "y2": 540, "color": "C8892F", "name": "RuleBot"},
    {"type": "text", "text": "{{title}}", "font": "NotoSansSC-Black", "size": 84,
